[HKEY_CURRENT_USER\Software\Classes\*\shell\FWXXL_EN\command]
@="\"C:\\Tools\\FasterWhisperTranscribe\\fw_en.cmd\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\*\shell\FWXXL_SPK]
